# ============================================================
# DermisAI — environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Flask runtime environment: development | production | testing
FLASK_ENV=development

# A long, random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Separate secret used to sign JWT access/refresh tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret

# PostgreSQL connection string.
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/skin_cancer_db

# Comma-separated list of allowed CORS origins (no trailing slash).
# Example for local dev + deployed frontend:
# CORS_ORIGINS=http://localhost:5500,https://dermisai.example.com
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
